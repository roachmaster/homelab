[Unit]
Description=Forge agent event runner
Requires=postgresql@16-main.service
Wants=homelab-forge-chat-tunnel.service
After=postgresql@16-main.service homelab-forge-chat-tunnel.service

[Service]
User=forge_agent
Group=forge_agent
ExecStart=/usr/bin/python3 -B /opt/homelab-forge/agent-runner/runner.py
LoadCredential=runner.token:/etc/homelab-forge/agent-runner/token
LoadCredential=forge.token:/etc/homelab-forge/web/llama.token
# Proxy transport (rollout step 2): point the runner at the proxy
# instead of direct Postgres. The token file is the coordinator
# caller's token from the proxy rollout; the runner reads it through
# its proxy-group membership.
Environment=FORGE_PG_PROXY_URL=http://127.0.0.1:18087
Environment=FORGE_PG_PROXY_TOKEN_FILE=/etc/homelab-forge/forge-pg-proxy/tokens/coordinator.token
Environment=FORGE_PG_PROXY_CALLER=coordinator
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
