[Unit]
Description=Forge Postgres proxy
Requires=postgresql@16-main.service
After=postgresql@16-main.service

[Service]
User=forge-pg-proxy
Group=forge-pg-proxy
ExecStart=/usr/bin/python3 -B /opt/homelab-forge/agent-runner/forge_pg_proxy.py --config /etc/homelab-forge/forge-pg-proxy/config.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
