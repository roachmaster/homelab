[Unit]
Description=Forge Postgres proxy
Requires=postgresql@16-main.service
After=postgresql@16-main.service

[Service]
User=forge-pg-proxy
Group=forge-pg-proxy
ExecStart=/opt/homelab-forge/event-current/bin/forge-pg-proxy --config /etc/homelab-forge/forge-pg-proxy/config.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
