[Unit]
Description=Homelab MCP server (read-only PostgreSQL, bearer-token auth)
After=network.target postgresql@16-main.service
Wants=postgresql@16-main.service

[Service]
Type=simple
User=homelab_mcp
Group=homelab_mcp
WorkingDirectory=/opt/homelab-forge/mcp/current
ExecStartPre=/usr/bin/python3 /opt/homelab-forge/mcp/current/mcp_server.py --config /etc/homelab-forge/mcp/server.json --check-config
ExecStart=/usr/bin/python3 /opt/homelab-forge/mcp/current/mcp_server.py --config /etc/homelab-forge/mcp/server.json
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=256M
TasksMax=64
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
