{
 "package": "forge-postgres",
 "edition": "2021",
 "dependencies": [
  "forge-core = { path = \"../forge-core\" }",
  "forge-work = { path = \"../forge-work\" }",
  "chrono = \"0.4\"",
  "serde_json = \"1\"",
  "sha2 = \"0.10\"",
  "tokio = { version = \"1\", features = [\"rt\", \"rt-multi-thread\", \"net\", \"time\"] }",
  "tokio-postgres = { version = \"0.7\", features = [\"with-uuid-1\", \"with-serde_json-1\", \"with-chrono-0_4\"] }",
  "uuid = \"1\""
 ],
 "note": "Path deps resolve when the crate is placed in the workspace (src/rust/forge-postgres). The harness out dir is a staging area, not the build."
}