<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/style.css">
    <script src="/main.js" defer></script>
  </head>
  <body>
    <header class="fg-header">
      <div class="fg-brand">
        {{{brand}}}
        {{{brand_context}}}
      </div>
      {{{header_actions}}}
      <p>{{subtitle}}</p>
    </header>
    <section id="runtime-recovery" class="fg-recovery" hidden>
      <p id="runtime-message" role="alert"></p>
      <button id="runtime-reload" type="button" data-reload>Reload application</button>
    </section>
    <div class="fg-app">{{{content}}}</div>
    <dialog id="leave-confirmation" class="fg-leave-dialog" aria-labelledby="leave-heading" aria-describedby="leave-description">
      <h2 id="leave-heading">Leave this page?</h2>
      <p id="leave-description">Forge will reload and try to restore your workspace. Any work that hasn’t been saved may be lost.</p>
      <div class="fg-row">
        <button id="leave-stay" class="fg-button-primary" type="button" autofocus>Stay</button>
        <button id="leave-confirm" type="button">Leave</button>
      </div>
    </dialog>
    <noscript>This application requires JavaScript and WebAssembly.</noscript>
  </body>
</html>
