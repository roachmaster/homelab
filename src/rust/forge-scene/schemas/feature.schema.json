{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roachmaster/homelab/src/rust/forge-scene/schemas/feature.schema.json",
  "title": "Forge feature AST",
  "description": "The typed tree a .feature file parses into. Given = capability, When = state or binding, Then = observable behaviour.",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature", "narrative", "scenarios"],
  "properties": {
    "feature": { "type": "string" },
    "narrative": { "type": "array", "items": { "type": "string" } },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "text"],
      "properties": {
        "line": { "type": "integer" },
        "text": { "type": "string" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "line", "given", "when", "then"],
      "properties": {
        "title": { "type": "string" },
        "line": { "type": "integer" },
        "given": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability"],
            "properties": { "capability": { "$ref": "#/$defs/step" } }
          }
        },
        "when": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state"],
            "properties": { "state": { "$ref": "#/$defs/step" } }
          }
        },
        "then": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["behavior"],
            "properties": { "behavior": { "$ref": "#/$defs/step" } }
          }
        }
      }
    }
  }
}
