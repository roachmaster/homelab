#[cfg(test)]
mod tests {
    use super::*;
    use forge_foundation::Provide;

    #[test]
    fn every_environment_freezes_or_names_what_is_missing() {
{{#envs}}{{#complete}}        assert!(wire_{{{env_name}}}().is_ok(), "{{{env_name}}} should assemble");
{{/complete}}{{^complete}}        assert!(
            matches!(wire_{{{env_name}}}(), Err(FoundationError::Freeze(_))),
            "{{{env_name}}} should be rejected at freeze"
        );
{{/complete}}{{/envs}}    }
{{#leaves}}{{#singleton}}
    #[test]
    fn {{{inst_name}}}_singleton_is_shared() {
        let provider =
            forge_foundation::SingletonProvider::<dyn {{{port}}}>::from_factory(&{{{type_name}}}Factory)
                .unwrap();
        assert!(Arc::ptr_eq(&provider.provide().unwrap(), &provider.provide().unwrap()));
    }
{{/singleton}}{{#lazy}}
    #[test]
    fn {{{inst_name}}}_lazy_singleton_waits_for_first_use() {
        let provider = forge_foundation::LazySingletonProvider::<dyn {{{port}}}, _>::new({{{type_name}}}Factory);
        assert!(!provider.is_initialized());
        let first = provider.provide().unwrap();
        assert!(provider.is_initialized());
        assert!(Arc::ptr_eq(&first, &provider.provide().unwrap()));
    }
{{/lazy}}{{#transient}}
    #[test]
    fn {{{inst_name}}}_transient_is_fresh_each_time() {
        let provider = forge_foundation::TransientProvider::<dyn {{{port}}}, _>::new({{{type_name}}}Factory);
        assert!(!Arc::ptr_eq(&provider.provide().unwrap(), &provider.provide().unwrap()));
    }
{{/transient}}{{/leaves}}{{#assisted}}
    #[test]
    fn {{{inst_name}}}_assisted_variants_carry_their_arguments() {
        let provider = forge_foundation::AssistedProvider::new({{{type_name}}}Factory);
        let first = provider.get("first".to_string()).unwrap();
        let second = provider.get("second".to_string()).unwrap();
        assert!(!Arc::ptr_eq(&first, &second));
        let probe = || {{{probe_request}}}("probe".to_string());
        assert_eq!(first.{{{probe_verb}}}(probe()).unwrap().0, "first");
        assert_eq!(second.{{{probe_verb}}}(probe()).unwrap().0, "second");
    }
{{/assisted}}{{#envs}}{{#complete}}
    #[test]
    fn {{{env_name}}}_slots_keep_their_lifecycles() {
        let scene = wire_{{{env_name}}}().unwrap();
{{#slots}}{{#shared}}        let provider = scene.{{{slot}}}().provider().unwrap();
        assert!(Arc::ptr_eq(&provider.provide().unwrap(), &provider.provide().unwrap()));
{{/shared}}{{#fresh}}        let provider = scene.{{{slot}}}().provider().unwrap();
        assert!(!Arc::ptr_eq(&provider.provide().unwrap(), &provider.provide().unwrap()));
{{/fresh}}{{#defaulted}}        assert!(scene.{{{slot}}}().is_default());
{{/defaulted}}{{#missing}}        assert!(scene.{{{slot}}}().provider().is_err());
{{/missing}}{{#decorations}}        let before = scene.{{{deco_name}}}().calls();
        let probe = {{{probe_request}}}("probe".to_string());
        provider.provide().unwrap().{{{probe_verb}}}(probe).unwrap();
        assert_eq!(scene.{{{deco_name}}}().calls(), before + 1);
{{/decorations}}{{/slots}}    }
{{/complete}}{{/envs}}
    #[test]
    fn client_example_runs() {
