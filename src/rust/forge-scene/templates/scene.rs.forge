// ---- Client example: only the container and its providers ---------------------

/// Walks every environment the way an application would: assemble the
/// container, ask a slot for its provider, acquire, call the port.
pub fn client() -> Result<Vec<String>, FoundationError> {
    let mut lines = Vec::new();
{{#envs}}{{#complete}}    let scene = {{{scene_type}}}Scene::assemble({{{scene_type}}}Env::{{{variant}}})?;
{{#slots}}{{^missing}}{{#verbs}}    lines.push(format!(
        "{{{env_name}}} {{{slot}}}.{{{verb}}} -> {}",
        scene
            .{{{slot}}}()
            .provider()?
            .provide()?
            .{{{verb}}}({{{request}}}("client".to_string()))?
            .0
    ));
{{/verbs}}{{/missing}}{{/slots}}{{/complete}}{{^complete}}    match {{{scene_type}}}Scene::assemble({{{scene_type}}}Env::{{{variant}}}) {
        Ok(_) => lines.push("{{{env_name}}} assembled".to_string()),
        Err(error) => lines.push(format!("{{{env_name}}} refused: {error}")),
    }
{{/complete}}{{/envs}}{{#assisted}}    let scene = {{{scene_type}}}Scene::assemble({{{scene_type}}}Env::{{{first_complete}}})?;
    let variant = scene.{{{inst_name}}}().get("client-{{{arg}}}".to_string())?;
    lines.push(format!(
        "{{{inst_name}}}(client-{{{arg}}}).{{{probe_verb}}} -> {}",
        variant.{{{probe_verb}}}({{{probe_request}}}("client".to_string()))?.0
    ));
{{/assisted}}    Ok(lines)
}

