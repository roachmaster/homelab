digraph Context {
graph [fontname="DejaVu Sans", fontsize=21, labelloc=t, labeljust=l, pad=0.35, nodesep=0.65, ranksep=0.9, bgcolor="white"]; node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, margin="0.22,0.16", color="#24576b", fillcolor="#e8f4f7", fontcolor="#163744", penwidth=1.4]; edge [fontname="DejaVu Sans", fontsize=11, color="#56717d", fontcolor="#34505f", penwidth=1.3, arrowsize=0.75];
rankdir=LR; label="01  System context — proposed reference application\nFramework libraries are linked inside; no input transport is selected";
user [label="Application operator\n[Person]\nRuns and inspects the application", fillcolor="#213b55", color="#213b55", fontcolor="white"];
caller [label="Calling application\n[External software system; illustrative]\nUses a selected input interface", fillcolor="#f0f2f4", color="#8b98a3"];
app [label="Forge reference application\n[Software system]\nAdmits work; owns job lifecycle", fillcolor="#087f8c", color="#087f8c", fontcolor="white", fontsize=16];
downstream [label="Downstream capability\n[External software system; optional]\nPerforms an external action", fillcolor="#f0f2f4", color="#8b98a3"];
user -> app [label="Run / inspect\nInterface not selected"];
caller -> app [label="Submit / query if needed\nInterface not selected", style=dashed];
app -> downstream [label="Invoke through owned port\nProtocol chosen only if needed", style=dashed];
}
