digraph Packages {
graph [fontname="DejaVu Sans", fontsize=21, labelloc=t, labeljust=l, pad=0.35, nodesep=0.65, ranksep=0.9, bgcolor="white"]; node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, margin="0.22,0.16", color="#24576b", fillcolor="#e8f4f7", fontcolor="#163744", penwidth=1.4]; edge [fontname="DejaVu Sans", fontsize=11, color="#56717d", fontcolor="#34505f", penwidth=1.3, arrowsize=0.75];
rankdir=TB; label="04  Package dependencies — compile-time imports, not runtime calls\nDashed edges are optional; an in-process driver can prove ingress without a transport starter";
app [label="reference-app\nTyped factories/provider bindings\n+ handlers / edge codecs / driver", fillcolor="#fff1d6", color="#ae7b26"];
adapter [label="chosen-ingress-adapter\nOptional; no transport selected"];
runtime [label="forge-runtime\nConfig + validated lifetime plan\nNo domain service lookup"];
bridge [label="forge-bridge\nBridge<P> / Registry<P>\nHeader + variant admission"];
contract [label="forge-ingress-contract\nEnvelope<P> / Ingress<P> / Handler<P>\nAdmissionPolicy / Outcome<R>", fillcolor="#087f8c", color="#087f8c", fontcolor="white"];
feature [label="jobs\nJobsPayload enum + policy\nFeature-owned outbound ports", fillcolor="#087f8c", color="#087f8c", fontcolor="white"];
transport [label="Selected I/O or codec library\nOnly at an optional boundary", fillcolor="#f0f2f4", color="#8b98a3"];
app -> { runtime bridge feature contract };
app -> adapter [style=dashed];
app -> transport [style=dashed, label="edge codec if selected"];
adapter -> contract;
adapter -> runtime [style=dashed];
adapter -> transport [style=dashed];
bridge -> contract;
{rank=same; adapter; runtime; bridge; feature;}
{rank=same; contract; transport;}
}
