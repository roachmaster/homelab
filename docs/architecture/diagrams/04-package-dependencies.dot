digraph Packages {
graph [fontname="DejaVu Sans", fontsize=21, labelloc=t, labeljust=l, pad=0.35, nodesep=0.55, ranksep=0.9, bgcolor="white"];
node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, margin="0.22,0.16", color="#24576b", fillcolor="#e8f4f7", fontcolor="#163744", penwidth=1.4];
edge [fontname="DejaVu Sans", fontsize=11, color="#56717d", fontcolor="#34505f", penwidth=1.3, arrowsize=0.75];
rankdir=TB; label="04  Implemented package dependencies — six execution core + command description + kernel + local system + three demos\nArrows are normal imports; dashed edges are optional Cargo dependencies. Disk uses native hosted I/O.";
app [label="forge-bootstrap-demo\nApplication-owned config / command enum\nCalls registrars; constructs explicitly\nPure default; opt-in messages / disk", fillcolor="#fff1d6", color="#ae7b26"];
kernel [label="forge-kernel\nOptional disk / node modules\nTyped clients / config / registrars"];
local [label="forge-local\nTyped application composition\nRegistered catalog + node / optional disk", fillcolor="#fff1d6", color="#ae7b26"];
terminal [label="forge-terminal / forge binary\nThin terminal + console I/O client\nReads catalog; invokes checked ingress"];
feature [label="forge-demo-messages\nCapability contracts + task\nTyped config / recipe / registrar"];
impl [label="forge-demo-memory-client\nIn-memory fake + typed config\nFactory / provider handle / registrar"];
bootstrap [label="forge-bootstrap\nPreparedGroup / Registry<G> / Frozen<G>\nAtomic tuples + declared order", fillcolor="#fff1d6", color="#ae7b26"];
bridge [label="forge-bridge\nHeader-selected typed dispatch"];
contract [label="forge-ingress-contract\nEnvelope<P> / Header / Response<R>\nPayload / AdmissionPolicy", fillcolor="#087f8c", color="#087f8c", fontcolor="white"];
provider [label="forge-provider\nFactory / InstanceProvider\nSingleton / Transient"];
task [label="forge-task\nTask::run (unchanged)"];
command [label="forge-command\nDescribeCommand / descriptors\nNo Task dependency"];
io [label="forge-io-client\nIoClient::execute"];
app -> {bootstrap bridge task contract};
app -> {impl feature} [style=dashed, label="messages"];
app -> {kernel io} [style=dashed, label="disk"];
app -> provider [style=dashed, label="messages or disk"];
kernel -> {bootstrap provider io};
kernel -> {task command} [style=dashed, label="node feature"];
local -> {bootstrap bridge contract provider task command io kernel};
terminal -> {local io};
feature -> {bootstrap provider task io};
impl -> {feature bootstrap provider io};
bridge -> contract;
{rank=same; impl; feature; kernel;}
{rank=same; bootstrap; provider; task; command; io; bridge;}
}
