digraph Components {
graph [fontname="DejaVu Sans", fontsize=21, labelloc=t, labeljust=l, pad=0.35, nodesep=0.65, ranksep=0.9, bgcolor="white"]; node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, margin="0.22,0.16", color="#24576b", fillcolor="#e8f4f7", fontcolor="#163744", penwidth=1.4]; edge [fontname="DejaVu Sans", fontsize=11, color="#56717d", fontcolor="#34505f", penwidth=1.3, arrowsize=0.75];
rankdir=TB; label="03  Components — inside the reference application host\nRuntime responsibilities; an installed adapter never bypasses the bridge";
caller [label="Input caller\n[External consumer; illustrative]", fillcolor="#f0f2f4", color="#8b98a3"];
db [shape=cylinder, label="Job ledger\n[Container: durable data store]\nTechnology undecided", fillcolor="#f0f2f4", color="#8b98a3"];
subgraph cluster_host { label="Application host [container boundary: Rust executable]"; fontname="DejaVu Sans"; fontsize=14; color="#2b7686"; style="rounded,dashed"; margin=24;
adapter [label="Chosen ingress adapter\n[Component; only if needed]\nBuild typed Envelope<P>\nUses injected boundary codec"];
bridge [label="Ingress bridge\n[Component]\nResolve header; authorize route\nCheck payload variant + deadline", fillcolor="#087f8c", color="#087f8c", fontcolor="white"];
registry [label="Frozen allowlisted registry\n[Component]\nDestination / version / variant\nExplicit typed handler bindings"];
handler [label="Jobs handler + use cases\n[Component]\nConsume JobsPayload enum\nResource authorization + policy"];
persist [label="Job-store adapter\n[Component]\nAtomic job + receipt persistence\nMaps storage failures"];
worker [label="Job worker\n[Component; later milestone]\nOwns claim / retry / completion"];
host [label="Composition + lifecycle host\n[Component]\nValidate config; assemble once\nStart, supervise, drain, stop", fillcolor="#fff1d6", color="#ae7b26"];
adapter -> bridge [label="Typed Envelope<P>\n+ trusted context"];
bridge -> registry [label="Resolve authorized binding"];
bridge -> handler [label="Invoke registered handler"];
handler -> persist [label="Feature-owned store port"];
worker -> persist [label="Claim / finish via owned port"];
host -> bridge [label="Construct + freeze registry", style=dashed];
host -> worker [label="Start / cancel / join", style=dashed];
}
caller -> adapter [label="Selected input interface"];
persist -> db [label="Store protocol\nnot selected"];
}
