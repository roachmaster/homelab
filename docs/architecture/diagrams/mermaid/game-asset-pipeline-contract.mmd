---
title: Implemented asset identity and bounded ownership
---
classDiagram
    class VerifiedManifest {
        digest
        supportedEntries
    }
    class Assets {
        uploadBuffer
        verifiedAtlas
    }
    class Loader {
        latestRequest
        preparedRoom
        retainedReplayLevels
    }
    class Room {
        epoch
        tick
        validatedLevel
    }
    class Timeline {
        segments
        manifestDigests
        effectiveInputs
    }
    class ArchivePort {
        readGeneration
        missingDigest
    }
    Assets *-- VerifiedManifest
    Assets --> Loader
    Loader --> Room
    Loader --> Timeline
    Timeline --> ArchivePort
    ArchivePort --> Assets
