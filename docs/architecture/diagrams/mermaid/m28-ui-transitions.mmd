flowchart TB
  I["Inspect or Refresh<br/>Admitted selection"] --> L["Loading<br/>New token and deadline"]
  L -->|"matching valid report"| R["Ready or Partial<br/>Retain accepted report key"]
  L -->|"current failure"| F["Failed<br/>Explicit recovery"]
  L -->|"cancel local wait"| C["Cancelled<br/>Ignore late result"]
  R --> Q["Local query / mode / paging<br/>Match report and mode<br/>No remote request"]
  R --> S["Open file or declaration<br/>Prepared source read<br/>Match report entry and digest"]
  S --> V["Verified source windows<br/>Local line paging and Wrap"]
  V --> W["Optional managed write<br/>Native revision fence and journal<br/>Receipt or reconciliation"]
  classDef current fill:#ddf5ee,stroke:#247d6a,color:#15352c
